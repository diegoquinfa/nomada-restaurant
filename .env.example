# ============================================================
# NÓMADA Cocina Fusión — Environment Variables
# ============================================================
# Copiar a .env y ajustar según entorno
# cp .env.example .env

# --- Server (Nitro) ---
PORT=3000
# NITRO_PORT=3000     # Alternativa a PORT
# HOST=0.0.0.0

# --- Node ---
NODE_ENV=production

# --- Site URL (usada en meta tags OG y JSON-LD) ---
# Por ahora está hardcodeada en src/routes/__root.tsx.
# Si se externaliza, definir acá:
# SITE_URL=https://nomadacartagena.com
