# NÓMADA Cocina Fusión — environment variables
# cp .env.example .env
#
# PostHog (client-side, so Astro requires the PUBLIC_ prefix; the old VITE_ names are no longer exposed).
# These are read at BUILD time: set them wherever `pnpm build` runs.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# EmDash encryption key for plugin secrets: `pnpm emdash secrets generate --write .env`
# EMDASH_ENCRYPTION_KEY=
