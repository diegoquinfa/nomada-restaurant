# ============================================================
# NÓMADA Cocina Fusión — Environment Variables
# ============================================================
# Copiar a .env y ajustar según entorno
# cp .env.example .env

# --- Server (Nitro) ---
PORT=3000
# NITRO_PORT=3000     # Alternativa a PORT
# HOST=0.0.0.0

# --- Node ---
NODE_ENV=development

# --- Site URL (usada en meta tags OG, Twitter Cards y JSON-LD) ---
VITE_SITE_URL=http://localhost:3000
VITE_POSTHOG_KEY=phc_thfi...
VITE_POSTHOG_HOST=https://us.i.posthog.com
