{
  "ignore": {
    "files": [".agents/**", "src/shared/ui/**"],
    "rules": [
      "deslop/unused-dependency",
      "deslop/unused-file",
      "react-doctor/require-pnpm-hardening"
    ],
    "overrides": [
      {
        "files": ["src/routes/__root.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["src/modules/pages/home/sections/home-how-to-order.tsx"],
        "rules": ["react-doctor/no-danger"]
      }
    ]
  },
  "rules": {
    "react-doctor/no-array-index-as-key": "error"
  }
}
