---
import { getEmDashEntry } from "emdash";
import { Blocks } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import { blockComponents } from "../components/blocks";

const { entry: page, error } = await getEmDashEntry("pages", "home");
if (error) return new Response("No se pudo cargar la página", { status: 500 });
if (!page) return Astro.rewrite("/404");
---

<Base>
  <Chrome>
    <main>
      <Blocks value={page.data.layout} components={blockComponents} />
    </main>
  </Chrome>
</Base>
