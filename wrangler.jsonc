{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomada-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "EMDASH_SITE_URL": "https://nomadarestaurantectg.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "nomada-web-db" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nomada-web-media" }],
  "images": { "binding": "IMAGES" },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["* * * * *"] }
}
